{
  "name": "smartlogi-saas",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter shared-types build && pnpm --filter ui-components build && pnpm --filter ui-kit build && pnpm --parallel --filter \"!shared-types\" --filter \"!ui-components\" --filter \"!ui-kit\" --filter \"!*-engine\" --filter \"!*-bridge\" --filter \"!*-components\" --filter \"!mobile-ui-kit\" --filter \"!prisma-schemas\" dev",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./backend/**\" --filter \"./api/**\" build",
    "vercel-build": "pnpm --filter ui-components build && pnpm --filter ui-kit build && pnpm --filter admin-portal build && cp -r frontend/feature-test/admin-portal/.next .next",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./backend/**\" --filter \"./api/**\" exec tsc --noEmit",
    "test": "pnpm --filter api-gateway test",
    "db:migrate": "pnpm --filter prisma-schemas migrate:deploy",
    "db:seed": "pnpm --filter prisma-schemas seed",
    "smoke": "node scripts/smoke-api.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "frontend/feature-test/*",
    "frontend/reporting/*",
    "frontend/mobile/*",
    "backend/*",
    "api/*",
    "packages/*"
  ],
  "devDependencies": {
    "@nestjs/testing": "10.3.10",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "next": "15.5.28",
    "prettier": "3.3.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2"
  },
  "dependencies": {
    "postcss": "8.4.39",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "3.4.7",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/throttler": "^5.1.1",
    "bullmq": "^5.8.5",
    "cache-manager": "^5.7.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "^8.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}
