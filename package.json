{
  "name": "smartlogi-saas",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"!shared-types\" --filter \"!*-engine\" --filter \"!*-bridge\" --filter \"!*-components\" --filter \"!mobile-ui-kit\" --filter \"!prisma-schemas\" dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "@nestjs/testing": "10.3.10",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "3.3.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2"
  },
  "dependencies": {
    "postcss": "8.4.39",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "3.4.7",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/throttler": "^5.1.1",
    "bullmq": "^5.8.5",
    "cache-manager": "^5.7.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "^8.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}
