' =============================================================================
' PlantUML — SmartLogi AI SaaS (Logistics, WMS & TMS Platform)
' Comprehensive Enterprise UML Architecture Documentation
' 
' Master Diagrams:
'   1. container-diagram (C4 Level 2 Container Architecture)
'   2. microservices-architecture (Component Architecture & Event Mesh)
'   3. ai-vrp-engine-components (Google OR-Tools & VRP Microservice)
'   4. entity-relationship-diagram (Multi-tenant Prisma ORM ERD)
'   5. deployment-diagram (Kubernetes & Infrastructure Topology)
'   6. usecase-overall (Multi-role Logistics Actors & Subsystems)
'   7. frontend-architecture (Next.js Portals & Hardware Integration)
'   8. seq-order-to-delivery (End-to-End Order Fulfillment Flow)
'   9. seq-realtime-gps-tracking (Go GPS Ingestion & Geofencing)
'  10. seq-ai-vrp-optimization (OR-Tools Multi-Vehicle Route Solver)
'  11. seq-wms-fifo-picking (FIFO/FEFO Wave Picking & PDA Scanning)
'  12. state-order-trip-lifecycle (Order & Delivery Trip State Machine)
'  13. state-inventory-movement (WMS Stock State Transitions)
'  14. activity-wms-fulfillment-pipeline (Warehouse Operations Activity Flow)
' =============================================================================

' =============================================================================
' 1. C4 CONTAINER DIAGRAM
' =============================================================================
@startuml container-diagram
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 40

skinparam package {
  BackgroundColor #F8F9FA
  BorderColor #5F6368
  FontColor #202124
  FontStyle bold
  FontSize 12
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #1A73E8
  FontColor #202124
  FontSize 11
}

skinparam database {
  BackgroundColor #E8F0FE
  BorderColor #1967D2
  FontColor #174EA6
  FontSize 11
}

skinparam queue {
  BackgroundColor #FEE2E2
  BorderColor #DC2626
  FontColor #991B1B
  FontSize 11
}

skinparam cloud {
  BackgroundColor #FEF7E0
  BorderColor #F9AB00
  FontColor #B06000
  FontSize 11
}

title Container Diagram - SmartLogi AI SaaS Platform (C4 Level 2)

package "Client Layer" as CLIENTS #FAFAFA {
  component "Tenant Portal (WMS & TMS)\n[Next.js 14 App Router, Shadcn UI]\n• Dispatch Tower, Warehouse Bin Grid\n• Port: 3000" as TENANT_PORTAL #FEFCE8
  component "SaaS Admin Portal\n[Next.js 14 Dashboard]\n• Tenant Provisioning, Billing, Plans\n• Port: 3001" as ADMIN_PORTAL #FEFCE8
  component "Driver Mobile App\n[React Native / PWA]\n• Offline Sync, Turn-by-Turn, Proof of Delivery\n• Background GPS Tracker" as DRIVER_APP #FEFCE8
  component "Warehouse Hardware Clients\n• PDA Laser Scanner (Barcode/QR)\n• Electronic Packing Scale (Web Serial API)" as HARDWARE #FEFCE8
}

package "API Gateway & Edge Layer" as GATEWAY_LAYER #F1F5F9 {
  component "Kong API Gateway\n[Kong 3.4 Alpine]\n• Path-based Microservice Routing\n• JWT Token & Tenant Schema Resolver\n• Rate Limiting & SSL Termination\n• Port: 8000 / 8443" as KONG_GW #EFF6FF
}

package "Core Microservices Tier" as SERVICES_LAYER #FFFFFF {
  component "IAM Service\n[NestJS, TypeScript]\n• Multi-tenant Auth & RBAC\n• Port: 3002" as IAM_SVC #EFF6FF

  component "Inventory Service (WMS Core)\n[NestJS, TypeScript]\n• Wave Picking, FIFO/FEFO Allocation\n• Zone/Rack/Bin Management, Scales\n• Port: 3003" as INVENTORY_SVC #EFF6FF

  component "Logistics Service (TMS Core)\n[NestJS, TypeScript]\n• Trips, Dispatching, COD Remittance\n• Geocoding & Route Jobs\n• Port: 3004" as LOGISTICS_SVC #EFF6FF

  component "Order Service\n[NestJS, TypeScript]\n• B2B/B2C Order Lifecycle & Tracking\n• Port: 3005" as ORDER_SVC #EFF6FF

  component "AI Engine (SAI Core)\n[FastAPI, Python 3.11]\n• Google OR-Tools VRP Solver\n• Demand Forecasting & Feedback Loop\n• Port: 5000" as AI_SVC #FFF7ED

  component "GPS Ingestion Service\n[Golang 1.21]\n• High-throughput Ping Handling\n• Geofence Checking\n• Port: 8080" as GPS_SVC #ECFDF5
}

package "Messaging & Persistence Layer" as DATA_LAYER #F8FAFC {
  database "Multi-Tenant PostgreSQL 16\n• Schema-per-tenant or TenantId isolation\n• 50+ Prisma Tables (WMS, TMS, Orders)\n• Port: 5432" as POSTGRES #E8F0FE

  queue "Apache Kafka & Redis 7\n• Kafka Topics: 'gps.telemetry', 'order.events'\n• Redis: Driver Positions & WMS Locks\n• Ports: 9092, 6379" as EVENT_BUS #FEE2E2
}

package "External SaaS & GIS Gateways" as EXT_SVCS #FEF7E0 {
  cloud "OpenStreetMap & OSRM Engine\n(Geocoding & Distance Matrix)" as OSRM_API
  cloud "SMS / Email Gateway\n(Delivery OTP & Notifications)" as NOTIF_EXT
}

' Connections
TENANT_PORTAL --> KONG_GW : HTTPS / GraphQL / REST
ADMIN_PORTAL --> KONG_GW : HTTPS / REST
DRIVER_APP --> KONG_GW : HTTPS REST
DRIVER_APP --> GPS_SVC : UDP / TCP Telemetry Stream
HARDWARE --> TENANT_PORTAL : Web Serial & HID Scanner

KONG_GW --> IAM_SVC : Route /api/v1/auth, /iam
KONG_GW --> INVENTORY_SVC : Route /api/v1/wms, /inventory
KONG_GW --> LOGISTICS_SVC : Route /api/v1/tms, /trips
KONG_GW --> ORDER_SVC : Route /api/v1/orders
KONG_GW --> AI_SVC : Route /api/v1/ai

IAM_SVC --> POSTGRES : Query Tenants & RBAC
INVENTORY_SVC --> POSTGRES : Optimistic Locking on Stock
LOGISTICS_SVC --> POSTGRES : Trips & Deliveries
ORDER_SVC --> POSTGRES : Order State Machine

LOGISTICS_SVC --> AI_SVC : HTTP POST /vrp/optimize
AI_SVC --> OSRM_API : Compute Distance Matrix
LOGISTICS_SVC --> OSRM_API : Map Waypoints & Geocoding

GPS_SVC --> EVENT_BUS : Publish telemetry & alerts
EVENT_BUS --> LOGISTICS_SVC : Consume GPS coordinates
LOGISTICS_SVC --> NOTIF_EXT : Trigger SMS Delivery Alerts
@enduml

' =============================================================================
' 2. MICROSERVICES & EVENT MESH ARCHITECTURE
' =============================================================================
@startuml microservices-architecture
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam linetype ortho

title Microservices Component Architecture & Event Mesh

package "Edge Routing Layer" #F8FAFC {
  component "Kong API Gateway\n• Plugins: Rate-Limiting, Key-Auth, CORS\n• Tenant Identification Filter" as KONG #EFF6FF
}

package "Domain Microservices" #FFFFFF {
  component "IAM Service\n• JWT Token Issuer\n• Granular RBAC Guards\n• Multi-tenant Org Resolver" as IAM #EFF6FF
  component "Order Service\n• Order Ingestion & Validation\n• Returns & RMA Handler" as ORDER #EFF6FF
  component "Inventory WMS Service\n• Zone/Rack/Bin Grid Model\n• FIFO / FEFO / LIFO Allocator\n• Pack Station & Scale Handler" as WMS #EFF6FF
  component "Logistics TMS Service\n• Dispatch Control Tower\n• Driver Assignments & COD\n• Geofence Trigger Manager" as TMS #EFF6FF
  component "AI VRP Engine\n• Google OR-Tools Solver\n• Capacity & Time Window Constraints\n• Continuous Machine Learning" as AI #FFF7ED
  component "GPS Ingestion Service (Go)\n• Concurrent Goroutine Pool\n• Low Latency Driver Tracker" as GPS #ECFDF5
  component "Notification Service\n• Multi-channel Dispatcher (SMS, Email, Push)" as NOTIF #EFF6FF
  component "Webhook Service\n• Outbound B2B Client Webhook Dispatcher" as WEBHOOK #EFF6FF
}

package "Event Mesh & Streaming (Kafka + Redis)" #FEE2E2 {
  queue "Kafka Topic: 'order.created'" as TOPIC_ORDER
  queue "Kafka Topic: 'wms.picked'" as TOPIC_WMS
  queue "Kafka Topic: 'tms.dispatched'" as TOPIC_TMS
  queue "Kafka Topic: 'gps.telemetry'" as TOPIC_GPS
  queue "Redis In-Memory: Driver Latest Coordinates" as REDIS_CACHE
}

KONG --> IAM
KONG --> ORDER
KONG --> WMS
KONG --> TMS
KONG --> AI

ORDER --> TOPIC_ORDER : Emits OrderCreated
TOPIC_ORDER --> WMS : Triggers Wave Picking & Allocation

WMS --> TOPIC_WMS : Emits ItemsPacked
TOPIC_WMS --> TMS : Triggers TMS Delivery Staging

TMS --> AI : Request Route Optimization (REST)
AI --> TMS : Return Optimal Vehicle Itineraries

TMS --> TOPIC_TMS : Emits TripDispatched
TOPIC_TMS --> NOTIF : Send SMS to Customers
TOPIC_TMS --> WEBHOOK : Notify External ERPs

GPS --> TOPIC_GPS : Stream coordinate batches
TOPIC_GPS --> TMS : Live Track & Detect Geofence Entry
GPS --> REDIS_CACHE : Cache latest (lat, lng, speed)
@enduml

' =============================================================================
' 3. AI VRP ENGINE COMPONENTS
' =============================================================================
@startuml ai-vrp-engine-components
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam linetype ortho

title AI VRP Engine Internal Architecture (FastAPI & Google OR-Tools)

package "FastAPI Application Layer (:5000)" #F8FAFC {
  component "FastAPI Engine Controller\n• POST /vrp/optimize\n• POST /forecast/demand\n• POST /feedback/record" as API_CTRL #EFF6FF
  component "Request Validator & Normalizer\n(Pydantic VRP Request Schemas)" as VALIDATOR #EFF6FF
}

package "VRP Solving Core" #FFF7ED {
  component "Distance & Duration Matrix Calculator\n• Calls OSRM / Haversine Matrix API\n• Real-world road network distance matrix" as MATRIX_CALC #FED7AA

  component "Google OR-Tools Routing Model Engine\n[pywraplp & routing_enums_pb2]" as ORTOOLS #FED7AA {
    component "RoutingIndexManager\n(Nodes, Vehicles, Depots)" as IDX_MGR #FFFFFF
    component "RoutingModel\n(Objective: Minimize Total Fleet Transit Time)" as ROUTE_MODEL #FFFFFF
  }

  component "Constraint Dimension Evaluators" as CONSTRAINTS #FDBA74 {
    component "Capacity Dimension\n(Vehicle Weight & Volume Limits)" as CAP_DIM #FFFFFF
    component "Time Window Dimension\n(Customer Opening Hours & Service Times)" as TIME_DIM #FFFFFF
    component "Driver Working Hours Limit\n(Max Shift Duration: 8 Hours)" as SHIFT_DIM #FFFFFF
  }

  component "Search Strategy & Metaheuristics\n• First Solution: PATH_CHEAPEST_ARC\n• Local Search: GUIDED_LOCAL_SEARCH" as SEARCH_STRAT #FED7AA
}

package "Learning & Continuous Improvement" #ECFDF5 {
  component "Feedback Loop & History Store\n• Driver Actual Route vs Predicted Time\n• Speed & Delay Adjustment Factors" as FEEDBACK #A7F3D0
  component "Demand Forecast Model (Prophet / Scikit-learn)\n• Seasonal Delivery Demand Prediction" as FORECAST #A7F3D0
}

API_CTRL --> VALIDATOR
VALIDATOR --> MATRIX_CALC
MATRIX_CALC --> IDX_MGR
IDX_MGR --> ROUTE_MODEL
ROUTE_MODEL --> CONSTRAINTS
ROUTE_MODEL --> SEARCH_STRAT
SEARCH_STRAT --> API_CTRL : Return Optimized Stops & Polyline
API_CTRL --> FEEDBACK : Store actual trip metrics
FEEDBACK ..> MATRIX_CALC : Apply speed calibration factors
@enduml

' =============================================================================
' 4. ENTITY RELATIONSHIP DIAGRAM (ERD)
' =============================================================================
@startuml entity-relationship-diagram
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 10
skinparam roundCorner 6
skinparam shadowing false
skinparam linetype ortho
skinparam classFontSize 10
skinparam classAttributeFontSize 9

title Entity Relationship Diagram (ERD) - Multi-Tenant Prisma Schema

package "Tenancy & Security" #EFF6FF {
  class Tenant {
    + String id [PK]
    + String name
    + String code [Unique]
    + String subscriptionPlanId [FK]
    + Boolean isActive
    + DateTime createdAt
  }

  class TenantUser {
    + String id [PK]
    + String tenantId [FK]
    + String email [Unique]
    + String passwordHash
    + String fullName
    + String role [ADMIN, DISPATCHER, WAREHOUSE, DRIVER]
    + Boolean isActive
  }
}

package "Warehouse Management System (WMS)" #ECFDF5 {
  class Warehouse {
    + String id [PK]
    + String tenantId [FK]
    + String code
    + String name
    + String address
    + Float latitude
    + Float longitude
  }

  class Zone {
    + String id [PK]
    + String warehouseId [FK]
    + String code [RECEIVING, STORAGE, PICKING, PACKING]
  }

  class Rack {
    + String id [PK]
    + String zoneId [FK]
    + String code
  }

  class Bin {
    + String id [PK]
    + String rackId [FK]
    + String code [e.g. A-01-02]
    + Float maxWeight
    + Float maxVolume
    + Boolean isOccupied
  }

  class Product {
    + String id [PK]
    + String tenantId [FK]
    + String sku [Unique]
    + String barcode
    + String name
    + Float weight
    + Float volume
    + String allocationStrategy [FIFO, FEFO, LIFO]
  }

  class Inventory {
    + String id [PK]
    + String tenantId [FK]
    + String productId [FK]
    + String binId [FK]
    + String lotNumber
    + DateTime expiryDate
    + Int quantity
    + Int reservedQuantity
    + Int version [Optimistic Lock]
  }

  class StockMovement {
    + String id [PK]
    + String tenantId [FK]
    + String productId [FK]
    + String fromBinId [FK]
    + String toBinId [FK]
    + Int quantity
    + String movementType [INBOUND, PUTAWAY, PICK, ADJUSTMENT]
    + DateTime timestamp
  }
}

package "Orders & Fulfillment" #FEFCE8 {
  class Order {
    + String id [PK]
    + String tenantId [FK]
    + String orderNumber [Unique]
    + String customerName
    + String customerPhone
    + String deliveryAddress
    + Float deliveryLat
    + Float deliveryLng
    + OrderStatus status
    + Decimal totalAmount
    + Decimal codAmount
    + DateTime createdAt
  }

  enum OrderStatus {
    CREATED
    ALLOCATED
    PICKING
    PACKED
    DISPATCHED
    DELIVERED
    FAILED
    RETURNED
  }

  class OrderItem {
    + String id [PK]
    + String orderId [FK]
    + String productId [FK]
    + Int quantity
    + Decimal unitPrice
  }

  class WavePicking {
    + String id [PK]
    + String tenantId [FK]
    + String warehouseId [FK]
    + String status [PENDING, IN_PROGRESS, COMPLETED]
    + DateTime startedAt
  }
}

package "Transportation Management System (TMS)" #FFF7ED {
  class Vehicle {
    + String id [PK]
    + String tenantId [FK]
    + String plateNumber [Unique]
    + Float maxPayloadKg
    + Float maxVolumeCbm
    + String vehicleType [TRUCK, VAN, BIKE]
    + Boolean isActive
  }

  class Driver {
    + String id [PK]
    + String tenantId [FK]
    + String userId [FK, Unique]
    + String licenseNumber
    + String phone
    + String status [AVAILABLE, ON_TRIP, OFF_DUTY]
  }

  class Trip {
    + String id [PK]
    + String tenantId [FK]
    + String tripCode [Unique]
    + String vehicleId [FK]
    + String driverId [FK]
    + TripStatus status
    + Float totalDistanceKm
    + Float estimatedDurationHours
    + DateTime scheduledStart
    + DateTime actualStart
    + DateTime completedAt
  }

  enum TripStatus {
    DRAFT
    ASSIGNED
    IN_TRANSIT
    COMPLETED
    CANCELLED
  }

  class TripStop {
    + String id [PK]
    + String tripId [FK]
    + String orderId [FK]
    + Int sequenceNumber
    + Float stopLat
    + Float stopLng
    + StopStatus status
    + DateTime eta
    + DateTime actualArrival
    + String proofOfDeliveryUrl
    + String signatureUrl
  }

  class GpsTrackingLog {
    + String id [PK]
    + String driverId [FK]
    + String tripId [FK]
    + Float latitude
    + Float longitude
    + Float speedKmh
    + DateTime recordedAt
  }
}

Tenant ||--o{ TenantUser : "has"
Tenant ||--o{ Warehouse : "owns"
Tenant ||--o{ Product : "catalog"
Tenant ||--o{ Order : "receives"
Tenant ||--o{ Vehicle : "fleet"
Tenant ||--o{ Trip : "dispatches"

Warehouse ||--o{ Zone : "contains"
Zone ||--o{ Rack : "contains"
Rack ||--o{ Bin : "contains"

Bin ||--o{ Inventory : "stores"
Product ||--o{ Inventory : "item"
Product ||--o{ StockMovement : "tracks"

Order ||--o{ OrderItem : "contains"
Product ||--o{ OrderItem : "ordered"

Trip ||--o{ TripStop : "consists of"
Vehicle ||--o{ Trip : "used for"
Driver ||--o{ Trip : "assigned to"
Order ||--o| TripStop : "delivered by"
Driver ||--o{ GpsTrackingLog : "transmits"
@enduml

' =============================================================================
' 5. DEPLOYMENT TOPOLOGY DIAGRAM
' =============================================================================
@startuml deployment-diagram
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false
skinparam linetype ortho

title Kubernetes & Cloud Production Topology - SmartLogi AI SaaS

node "Kubernetes Cluster: smartlogi-prod" as K8S_CLUSTER {
  
  package "Ingress Controller" {
    component "Kong Gateway Ingress Pod\n• Ports 80 / 443 TLS\n• Plugin: CORS, JWT, KeyAuth" as KONG_POD #EFF6FF
  }

  package "Presentation Services" {
    component "Tenant Portal Pods (Replicas: 3)\n[Next.js 14 SSR]\n• Port: 3000" as TENANT_POD #FEFCE8
    component "Admin Portal Pods (Replicas: 2)\n[Next.js 14]\n• Port: 3001" as ADMIN_POD #FEFCE8
  }

  package "Stateless Application Microservices" {
    component "IAM Service Pods (Replicas: 2)\n• Port: 3002" as IAM_POD #EFF6FF
    component "Inventory WMS Pods (Replicas: 3)\n• Port: 3003" as WMS_POD #EFF6FF
    component "Logistics TMS Pods (Replicas: 3)\n• Port: 3004" as TMS_POD #EFF6FF
    component "Order Service Pods (Replicas: 2)\n• Port: 3005" as ORDER_POD #EFF6FF
    component "AI VRP Solver Pods (Replicas: 2)\n• FastAPI + OR-Tools (Port: 5000)" as AI_POD #FFF7ED
    component "Go GPS Ingestion Pods (Replicas: 4)\n• High concurrency (Port: 8080)" as GPS_POD #ECFDF5
  }

  package "Stateful Middleware & Caching" {
    queue "Kafka Cluster (3 Brokers + Zookeeper)\n• Persistent Volumes: 500GB" as KAFKA_CLUSTER #FEE2E2
    queue "Redis Sentinel Cluster (Master-Replica)\n• Caching & Distributed Locks" as REDIS_CLUSTER #FEE2E2
  }

  package "Monitoring & Observability" {
    component "Prometheus & Grafana Pods\n• Scrapes metrics from Microservices" as MONITOR_POD #F3F4F6
  }
}

node "Managed Database Tier (Cloud Provider)" as DB_TIER #E8F0FE {
  database "Managed PostgreSQL 16 Cluster\n• Multi-AZ High Availability\n• Primary Read-Write + Read Replica\n• Port: 5432" as CLOUD_PG
}

KONG_POD --> TENANT_POD
KONG_POD --> ADMIN_POD
KONG_POD --> IAM_POD
KONG_POD --> WMS_POD
KONG_POD --> TMS_POD
KONG_POD --> ORDER_POD
KONG_POD --> AI_POD

IAM_POD --> CLOUD_PG
WMS_POD --> CLOUD_PG
TMS_POD --> CLOUD_PG
ORDER_POD --> CLOUD_PG

WMS_POD --> REDIS_CLUSTER : Acquire lock on Bin
GPS_POD --> KAFKA_CLUSTER : Produce telemetry events
KAFKA_CLUSTER --> TMS_POD : Consume GPS updates
TMS_POD --> AI_POD : Submit VRP route solve request
@enduml

