    frame "public Schema\n• SystemAdmin, SubscriptionPlan, Tenant" as SCHEMA_PUB #FFFFFF
    frame "tenant_a Schema\n• Warehouse, Zone, Bin, Inventory, Order" as SCHEMA_A #FFFFFF
    frame "tenant_b Schema\n• Warehouse, Zone, Bin, Inventory, Order" as SCHEMA_B #FFFFFF
  }
}

REQ_HEADER --> KONG_TENANT
KONG_TENANT --> TENANT_MIDDLEWARE : Proxied HTTP Request
TENANT_MIDDLEWARE --> PRISMA_EXT : Sets request.schemaName = 'tenant_a'
PRISMA_EXT --> SCHEMA_A : Query executed within tenant_a isolated search_path
PRISMA_EXT ..> SCHEMA_PUB : Joins global subscriptions
@enduml

' =============================================================================
' 21. SEQUENCE: DRIVER SOS EMERGENCY ALERT WORKFLOW
' =============================================================================
@startuml seq-driver-sos-emergency
!theme plain
autonumber
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

title Sequence: Driver SOS Panic Button & Emergency Dispatch Protocol

actor "Driver" as DRIVER #EFF6FF
participant "Driver Mobile App" as APP #FEFCE8
participant "Go GPS Ingestion (:8080)" as GO_GPS #ECFDF5
queue "Kafka Topic ('alerts.sos')" as KAFKA #FEE2E2
participant "TMS Logistics Service (:3004)" as TMS #EFF6FF
database "PostgreSQL DB" as DB #E8F0FE
participant "Dispatch Tower (Web)" as WEB #FEFCE8
actor "Fleet Supervisor" as DISPATCHER #FEFCE8

DRIVER -> APP: Presses Emergency SOS Panic Button (Hold 3s)
activate APP
APP -> APP: Vibrate & Capture Precise GPS Coordinates (Lat: 10.7812, Lng: 106.6982)
APP -> GO_GPS: POST /api/v1/telemetry/sos { driverId, tripId, lat, lng, severity: 'CRITICAL', reason: 'ACCIDENT' }
deactivate APP

activate GO_GPS
GO_GPS -> KAFKA: Publish 'alerts.sos' Event with High Priority
deactivate GO_GPS

KAFKA -> TMS: Consume 'alerts.sos' Event
activate TMS
TMS -> DB: INSERT INTO sos_alerts (driverId, tripId, latitude, longitude, status = 'ACTIVE', severity = 'CRITICAL')
TMS -> DB: UPDATE trips SET status = 'EMERGENCY_HOLD' WHERE id = tripId

TMS -> WEB: WebSocket Emit 'sos:broadcast' { alertId, driverName, phone, lat, lng, vehiclePlate }
deactivate TMS

activate WEB
WEB -> WEB: Flash Red Screen Overlay & Trigger Auditory Siren
WEB -> WEB: Center Leaflet Map on Driver GPS Marker & Show Emergency Rescue Route
deactivate WEB

DISPATCHER -> WEB: Acknowledges Alert & Calls Driver / Local Emergency (115/113)
DISPATCHER -> TMS: PATCH /sos-alerts/:id/resolve { status: 'RESOLVED', actionTaken: 'Ambulance dispatched' }
TMS -> DB: UPDATE sos_alerts SET status = 'RESOLVED', resolvedAt = now(), resolvedById = dispatcherId
TMS -> APP: Push Notification: "Rescue protocol activated. Help is on the way."
@enduml


