title Frontend Client Architecture (Tenant Portal & Hardware Integration)

package "Presentation Components (React 18 & Next.js 14)" #FAFAFA {
  component "Dispatch Control Tower\n• Leaflet Map with Real-time Markers\n• Vehicle Polyline Trails\n• Geofence Boundaries Overlay" as DISPATCH_TOWER #FEFCE8
  component "WMS Bin Management Grid\n• Interactive 3D/2D Warehouse Layout\n• Zone, Rack, Bin Color-coded Capacity" as WMS_GRID #FEFCE8
  component "Packing Station Screen\n• Barcode Scanning Feedback\n• Weight Verification Modal" as PACK_STATION #FEFCE8
  component "Order & Trip Management Tables\n• TanStack Table v8, Advanced Filters\n• Bulk Action Toolbar" as TABLE_VIEW #FEFCE8
}

package "Security & Authorization Layer" #EFF6FF {
  component "<Can permission='...'> Wrapper\n• Button-level Granular RBAC Guard\n• Evaluates permissions array from JWT" as CAN_GUARD #DBEAFE
  component "Tenant Context Provider\n• Active Tenant Schema & Branch ID" as TENANT_CTX #DBEAFE
}

package "Hardware Integration Hooks" #ECFDF5 {
  component "useWebSerialScale Hook\n• Connects to RS-232 / USB Electronic Scales\n• Reads tare & live net weight stream" as SCALE_HOOK #A7F3D0
  component "useBarcodeScanner Hook\n• Intercepts HID Laser Scanner Keypresses\n• Buffers characters & detects Enter key" as SCAN_HOOK #A7F3D0
